{
  "rules": {
    "games": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "$pin.matches(/^[0-9]{6}$/)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games/' + $pin + '/host').exists() && root.child('games/' + $pin + '/state').val() !== 'end'",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 16"
          }
        },
        "answers": {
          "$qk": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games/' + $pin + '/players/' + $uid).exists() && root.child('games/' + $pin + '/state').val() === 'q' && root.child('games/' + $pin + '/qk').val() === $qk",
              ".validate": "newData.child('a').isNumber() && newData.child('a').val() >= 0 && newData.child('a').val() <= 3 && newData.child('t').val() === now"
            }
          }
        },
        "picks": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games/' + $pin + '/state').val() === 'pick' && root.child('games/' + $pin + '/team/' + $uid).val() === root.child('games/' + $pin + '/turn').val()",
            ".validate": "newData.child('c').isNumber() && newData.child('r').isNumber() && newData.child('t').val() === now"
          }
        }
      }
    },
    "lb": {
      "$ch": {
        "$game": {
          "$period": {
            ".read": true,
            ".indexOn": [
              "s"
            ],
            "$key": {
              ".write": "auth != null && !data.exists() && newData.exists()",
              ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 16 && newData.child('s').isNumber() && newData.child('s').val() >= 0 && newData.child('s').val() <= 60000 && newData.child('t').val() === now && newData.child('u').val() === auth.uid && $key.matches(/^[0-9a-z]{1,8}$/) && $game.matches(/^(speed|streak|tf|board|boss|match|memory|typing)_[ENH]$/)"
            }
          }
        }
      }
    },
    "secrets": {
      "$pid": {
        ".read": false,
        ".write": "auth != null && !data.exists() && $pid.matches(/^[a-z0-9]{10}$/)",
        ".validate": "newData.isString() && newData.val().length === 16"
      }
    },
    "links": {
      "$pid": {
        ".read": false,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val() === root.child('secrets/' + $pid).val()"
        }
      }
    },
    "players": {
      ".read": true,
      "$pid": {
        ".write": "auth != null && root.child('links/' + $pid + '/' + auth.uid).exists()",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16"
        }
      }
    },
    "squads": {
      ".read": true,
      "$sid": {
        ".write": "auth != null && ((!data.exists() && root.child('links/' + newData.child('owner').val() + '/' + auth.uid).exists()) || (data.exists() && root.child('links/' + data.child('owner').val() + '/' + auth.uid).exists()))",
        ".validate": "$sid.matches(/^[A-Z2-9]{5}$/) && newData.hasChildren(['name','owner'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
        },
        "members": {
          "$pid": {
            ".write": "auth != null && root.child('links/' + $pid + '/' + auth.uid).exists()"
          }
        },
        "week": {
          "$wk": {
            "$pid": {
              ".write": "auth != null && root.child('links/' + $pid + '/' + auth.uid).exists() && root.child('squads/' + $sid + '/members/' + $pid).exists()"
            }
          }
        }
      }
    },
    "feed": {
      "$sid": {
        ".read": true,
        "$key": {
          ".write": "auth != null && !data.exists() && root.child('links/' + newData.child('p').val() + '/' + auth.uid).exists() && root.child('squads/' + $sid + '/members/' + newData.child('p').val()).exists()",
          ".validate": "newData.hasChildren(['p','n','kind','text']) && newData.child('text').isString() && newData.child('text').val().length <= 160"
        }
      }
    },
    "mmo": {
      "$d": {
        "$s": {
          "p": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "$d.matches(/^[0-4]$/) && $s.matches(/^(day|mid|night)$/) && newData.hasChildren(['c','x','y','t'])",
              "c": {
                ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150"
              },
              "v": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
              },
              "d": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "s": {
                ".validate": "newData.val() === $s"
              },
              "u": {
                ".validate": "newData.isString() && newData.val().matches(/^(patrol|swat|k9|neg|marine|brt|hoi|det|sro)$/)"
              },
              "st": {
                ".validate": "newData.isString() && newData.val().matches(/^(patrol|call)$/)"
              },
              "r": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "t": {
                ".validate": "newData.val() === now"
              },
              "q": {
                ".validate": "newData.hasChildren(['k','t'])",
                "k": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
                },
                "t": {
                  ".validate": "newData.val() === now"
                },
                "$o": {
                  ".validate": false
                }
              },
              "b": {
                ".validate": "newData.hasChildren(['x','y','t'])",
                "x": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150"
                },
                "y": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150"
                },
                "l": {
                  ".validate": "newData.isString() && newData.val().length <= 48"
                },
                "t": {
                  ".validate": "newData.val() === now"
                },
                "$o": {
                  ".validate": false
                }
              },
              "a": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "$o": {
                ".validate": false
              },
              "n": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 15"
              },
              "f": {
                ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().matches(/^[a-z0-9,]*$/)"
              }
            }
          }
        }
      },
      "chat": {
        "$d": {
          "$day": {
            ".read": "auth != null && $d.matches(/^[0-4]$/) && $day.matches(/^[0-9]{8}$/)",
            "$k": {
              ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
              ".validate": "newData.hasChildren(['u','c','m','t']) && $k.matches(/^[a-z0-9A-Z]{6,24}$/)",
              "u": {
                ".validate": "newData.isString()"
              },
              "c": {
                ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
              },
              "m": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
              },
              "s": {
                ".validate": "newData.isString() && newData.val().matches(/^(day|mid|night)$/)"
              },
              "t": {
                ".validate": "newData.val() === now"
              },
              "$o": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}